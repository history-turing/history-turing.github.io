---
import { Image } from 'astro:assets'

import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [{ depth: 2, slug: 'github', text: 'GitHub' }]
---

<PageLayout title='项目' {headings}>
  <p>项目页面正在整理中，之后会在这里补充个人项目和作品。</p>
  <p>目前可以先通过 GitHub 查看我的动态和代码。</p>
  <Button
    title='访问 GitHub'
    class='w-fit'
    href='https://github.com/history-turing'
    target='_blank'
    variant='ahead'
  />

  <h2 id='github'>GitHub</h2>
  <p>
    <Image
      src='https://ghchart.rshah.org/B9965B/history-turing'
      format='svg'
      alt='history-turing 的 GitHub 贡献图'
      inferSize
      loading='lazy'
    />
  </p>
</PageLayout>
